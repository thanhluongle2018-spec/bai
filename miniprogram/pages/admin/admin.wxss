.page { min-height: 100vh; background: #f0f3f7; padding-bottom: 80rpx; }
.state { padding: 80rpx 40rpx; text-align: center; color: #5a6b7c; }
.deny { color: #c0392b; }
.tabs { display: flex; background: #fff; }
.tab { flex: 1; text-align: center; padding: 22rpx; color: #5a6b7c; }
.tab.on { color: #1a2b3c; font-weight: 700; box-shadow: inset 0 -4rpx 0 #c45c26; }
.toolbar { display: flex; gap: 16rpx; padding: 20rpx; align-items: center; }
.search { flex: 1; background: #fff; padding: 14rpx; border-radius: 8rpx; }
.item { background: #fff; margin: 0 20rpx 12rpx; padding: 20rpx; border-radius: 8rpx; }
.name { font-weight: 600; }
.badge { margin-left: 12rpx; font-size: 20rpx; color: #c0392b; font-weight: 400; }
.meta { font-size: 22rpx; color: #8a97a5; margin-top: 6rpx; }
.drawer { margin-top: 16rpx; }
.toast { position: fixed; bottom: 40rpx; left: 40rpx; right: 40rpx; background: #1a2b3c; color: #fff; text-align: center; padding: 16rpx; border-radius: 8rpx; font-size: 24rpx; }
