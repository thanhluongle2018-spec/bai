.editor {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background: #f0f3f7;
}

.status-bar {
  background: #1a2b3c;
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  text-align: center;
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #d5dde6;
  margin-top: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx;
  color: #5a6b7c;
  font-size: 28rpx;
}

.tab.on {
  color: #1a2b3c;
  font-weight: 700;
  box-shadow: inset 0 -4rpx 0 #c45c26;
}

.panel {
  min-height: 280rpx;
}

.preview-panel {
  padding: 24rpx;
}

.preview-wrap {
  display: flex;
  justify-content: center;
  background:
    linear-gradient(45deg, #ddd 25%, transparent 25%),
    linear-gradient(-45deg, #ddd 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #ddd 75%),
    linear-gradient(-45deg, transparent 75%, #ddd 75%);
  background-size: 24px 24px;
  background-position: 0 0, 0 12px, 12px -12px, -12px 0;
  background-color: #eee;
  padding: 24rpx;
  border-radius: 8rpx;
}

.preview-meta {
  text-align: center;
  margin-top: 16rpx;
  color: #5a6b7c;
  font-size: 24rpx;
}

.retry {
  margin: 20rpx auto;
  width: 60%;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  background: rgba(240, 243, 247, 0.96);
  border-top: 1rpx solid #d5dde6;
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 2px;
  height: 2px;
}
