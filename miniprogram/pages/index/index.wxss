.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(120% 80% at 10% 0%, rgba(196, 92, 38, 0.12), transparent 55%),
    linear-gradient(165deg, #e8eef5 0%, #f0f3f7 40%, #dfe7f0 100%);
  display: flex;
  flex-direction: column;
}

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 8vh;
  animation: rise 0.7s ease-out both;
}

.brand {
  font-family: "Songti SC", "Noto Serif SC", Georgia, serif;
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: #1a2b3c;
  line-height: 1.15;
}

.tagline {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #5a6b7c;
  max-width: 520rpx;
  line-height: 1.5;
  animation: rise 0.7s 0.12s ease-out both;
}

.cta {
  margin-top: 56rpx;
  align-self: flex-start;
  min-width: 360rpx;
  animation: rise 0.7s 0.22s ease-out both;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action {
  padding: 18rpx 28rpx;
  border-bottom: 2rpx solid #1a2b3c;
  color: #1a2b3c;
  font-size: 26rpx;
}

.legal {
  text-align: center;
  font-size: 24rpx;
  color: #5a6b7c;
}

.sep {
  margin: 0 12rpx;
  color: #a0aab5;
}

.sync {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a97a5;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}
