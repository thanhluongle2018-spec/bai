.color-panel {
  background: #fff;
  padding: 24rpx;
}

.title {
  font-weight: 600;
  margin-bottom: 16rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.swatch {
  width: 140rpx;
  text-align: center;
}

.preview {
  width: 140rpx;
  height: 140rpx;
  border: 2rpx solid #d5dde6;
  border-radius: 8rpx;
}

.swatch.on .preview {
  border-color: #c45c26;
  box-shadow: 0 0 0 4rpx rgba(196, 92, 38, 0.25);
}

.label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5a6b7c;
}

.note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a97a5;
}
