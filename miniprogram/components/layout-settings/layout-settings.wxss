.settings { background: #fff; padding: 24rpx; }
.block { margin-bottom: 24rpx; }
.label { font-weight: 600; margin-bottom: 12rpx; }
.row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  padding: 12rpx 20rpx;
  border: 2rpx solid #d5dde6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #5a6b7c;
}
.chip.on { border-color: #c45c26; color: #1a2b3c; font-weight: 600; }
.meta { font-size: 22rpx; color: #8a97a5; line-height: 1.6; }
